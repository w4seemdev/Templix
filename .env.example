# Copy this file to .env and fill in your keys

# ─── Supabase ───────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Stripe ─────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# ─── Edge function secrets (NOT part of this file) ──────────
# These never ship in the client bundle. Set them on the Supabase project:
#   supabase secrets set SITE_URL=https://your-site.example
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL is the canonical site origin. create-checkout and verify-download
# allow only it (plus http://localhost:5173) for CORS and for the post-payment
# redirect, so it must match the deployed URL exactly — no trailing slash.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform automatically.
